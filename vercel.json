{
  "version": 2,
  "buildCommand": "cd server && npm install && npm run build",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "server/api/index.ts": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/api/index.ts"
    }
  ]
}
